# ==============================================================================
# QuizForge AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the values to match your local setup:
#   copy .env.example .env
#
# DO NOT commit your actual '.env' file containing passwords to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# The port that the Express backend server listens on
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# URL of the React/Vite frontend (used for CORS permissions)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. MySQL / MariaDB Database Configuration
# ------------------------------------------------------------------------------
# Database host (typically localhost or 127.0.0.1 for local development)
DB_HOST=localhost

# Database port (default MySQL/MariaDB port is 3306)
DB_PORT=3306

# Database user (e.g., 'root' for default XAMPP/local dev, or a dedicated user)
DB_USER=root

# Database password (leave empty if your local root user has no password, e.g., XAMPP)
DB_PASSWORD=

# Database name created by the application
DB_NAME=quizforge_ai

# Maximum number of concurrent connections in the MySQL pool
DB_CONNECTION_LIMIT=20

# ------------------------------------------------------------------------------
# 3. AI Tutor & Question Generation Service (Optional / Local LLM)
# ------------------------------------------------------------------------------
# Endpoint for the integrated FastAPI AI Tutor service
QWEN_TUTOR_API_URL=http://127.0.0.1:8001/api/v1/tutor/chat

# Base URL for the local llama-server (llama.cpp) inference engine
LLM_BASE_URL=http://127.0.0.1:8082

# Optional path to existing StatIQ AI project or custom models directory
# If left commented or empty, the app uses built-in defaults or local ai-service
# STATIQ_PROJECT_DIR=D:\Projects\StatIQ-AI-project
