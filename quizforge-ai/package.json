{
  "name": "quizforge-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "nodemon server/server.js",
    "dev:ai": "node scripts/start-ai.js",
    "dev:all": "concurrently -k -n WEB,API,AI -c \"cyan,magenta,yellow\" \"npm run dev\" \"npm run server\" \"npm run dev:ai\"",
    "build": "vite build",
    "start": "node server/server.js",
    "test:db": "node server/test-db.js",
    "db:init": "node scripts/init-db.js",
    "db:check": "node scripts/check-db.js",
    "diagnostics": "node scripts/check-system.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "mysql2": "^3.24.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
